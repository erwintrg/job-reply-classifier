# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Where mail comes from: gmail | fixtures
SOURCE=gmail
# Who classifies: anthropic | claude-cli | mock
CLASSIFIER=anthropic
# Where results go, comma separated: stdout, jsonl, taskboard, webhook
SINKS=stdout,jsonl,taskboard

# Gmail: one OAuth client and one refresh token per inbox (see README, "Gmail access"),
# scope https://www.googleapis.com/auth/gmail.readonly
GMAIL_CLIENT_ID=replace-me.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=replace-me
GMAIL_INBOX_1=you@example.com
GMAIL_REFRESH_TOKEN_1=replace-me
GMAIL_INBOX_2=you@example.org
GMAIL_REFRESH_TOKEN_2=replace-me

# Classifier: Anthropic API (pip install -e ".[anthropic]")
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-haiku-4-5
# Classifier: local Claude Code CLI, uses your Claude login instead of an API key
CLAUDE_CLI=claude
CLAUDE_CLI_MODEL=haiku
# Set to 0 for CLI versions without --json-schema
CLAUDE_CLI_JSON_SCHEMA=1

# Sinks
JSONL_PATH=data/events.jsonl
TASKBOARD_CSV=data/task-board.csv
WEBHOOK_URL=https://hooks.example.com/replace-me
# json (whole event) or slack (Slack incoming webhook text)
WEBHOOK_FORMAT=slack
# Which priorities the webhook gets: loud, quiet
WEBHOOK_PRIORITIES=loud

# Behaviour
STATE_PATH=data/state.json
TIMEZONE=Europe/Berlin
# Rejections that arrive inside this window wait until it ends. Use "off" to disable.
QUIET_HOURS=23:00-07:00
POLL_SECONDS=120
MAX_ATTEMPTS=3
LOOKBACK_HOURS=72
FIRST_RUN_LOOKBACK_HOURS=24
